# Copy to .env.local (git-ignored) and fill in what you have. Everything here is optional:
# with no variables set the demo runs fully on sample data and the two public Upstox files.
# No OAuth variables: this project has no login (PRODUCT.md §11).

# Optional; read-only Upstox Analytics Token (Developer Apps -> Analytics; one year, GET only).
# Without it, /api/upstox/{ltp,charges,fmv-2018,corporate-actions} return 501 and the UI falls back to cached values.
# Server-side only: it is read inside the serverless function and never reaches the browser.
UPSTOX_ANALYTICS_TOKEN=

# Upstox OAuth Variables
# These are required to enable the "Connect Upstox" feature.
# Create an app at https://account.upstox.com/developer/apps
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Used by iron-session to encrypt the session cookie.
# MUST be a strong, random string of at least 32 characters.
SESSION_SECRET=
