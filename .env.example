# Copy to .env.local (git-ignored) and fill in what you have. Everything here is optional:
# with no variables set the demo still runs on sample data plus the two public Upstox files, and
# "Connect Upstox" simply reports that login is not configured.

# Optional, and normally left empty: a read-only Analytics Token (Developer Apps -> Analytics, one year, GET only).
# Leaving it empty is the expected state. /api/upstox/{ltp,charges,fmv-2018,corporate-actions} then answer 501 and
# the UI quietly keeps its cached values with a "Using cached values" tag - not an error.
# Connecting Upstox (the OAuth variables below) covers those four endpoints with the session token instead.
# Server-side only: read inside the serverless function, never sent to the browser.
UPSTOX_ANALYTICS_TOKEN=

# Upstox OAuth variables. Optional too: set them only if you want the "Connect Upstox" button to work.
# Login is limited to the app owner (a personal app); other users need multi-client approval from Upstox.
# Create an app at https://account.upstox.com/developer/apps
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
# Must match a redirect URI registered on the Upstox app, character for character.
# Local: http://localhost:5180/api/auth/callback   Production: https://upstox-ass.vercel.app/api/auth/callback
UPSTOX_REDIRECT_URI=http://localhost:5180/api/auth/callback

# Used by iron-session to encrypt the session cookie.
# MUST be at least 32 random characters, e.g. node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=
